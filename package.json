{
  "name": "registry",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "check": "bun run check:ts && bun run check:biome",
    "check:ts": "tsc --noEmit",
    "check:biome": "biome check .",
    "lint": "bun run check:ts && biome lint .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "postgres": "^3.4.9",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.3.0",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  }
}
